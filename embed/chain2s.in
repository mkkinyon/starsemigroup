op(400, infix, "*").
formulas(assumptions).

% ---- projection algebra axioms ----
x * x = x.
(y * x) * x = y * x.
(x * y) * x = y * x.
((z * x) * y) * x = z * (y * x).
(((z * x) * y) * x) * y = (z * x) * y.

% ---- triangle hypotheses on constants a1,a2,a3,b1,b2,b3,cw,cz ----
% (H1) cyclic reduction suffices, as for the hexagon
a1 * a2 = cw.   a2 * a3 = cw.   a3 * a1 = cw.
b1 * b2 = cz.   b2 * b3 = cz.   b3 * b1 = cz.
% (H2)
a1 * b1 = b1 * a1.   a2 * b2 = b2 * a2.   a3 * b3 = b3 * a3.
% (H3) a1 |><| b2, a2 |><| b3, a3 |><| b1:   b_j * a_i = a_i  and  a_i * b_j = b_j
b2 * a1 = a1.   a1 * b2 = b2.
b3 * a2 = a2.   a2 * b3 = b3.
b1 * a3 = a3.   a3 * b1 = b1.

cw != cz.
% walk elements
e5 = a3 * b2.
e6 = e5 * a1.
e7 = e6 * b3.
e8 = e7 * a2.
e9 = e8 * b1.
e10 = e9 * a3.
e11 = e10 * b2.
e12 = e11 * a1.
% descent steps and matched steps
b2 * a1 = a1.
a1 * b2 = b2.
a1 * b3 = b3.
b3 * a2 = a2.
a2 * b3 = b3.
a2 * b1 = b1.
b1 * a2 = a2.
b1 * a3 = a3.
a3 * b1 = b1.
a3 * e5 = e5.
e5 * a3 = a3.
e5 * e6 = e6.
e6 * e5 = e5.
e6 * e7 = e7.
e7 * e8 = e8.
e8 * e7 = e7.
e8 * e9 = e9.
e9 * e8 = e8.
e9 * e10 = e10.
e10 * e9 = e9.
e10 * e11 = e11.
e11 * e10 = e10.
e11 * e12 = e12.
e12 * e11 = e11.
% bottom closes
e12 * e7 = e7.
% chain strictly descending
a1 != e6.
e6 != e12.
end_of_list.

