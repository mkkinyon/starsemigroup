set(prolog_style_variables).
op(400, infix, "*").
assign(max_seconds, 120).
formulas(assumptions).
X*X = X.
(Y*X)*X = Y*X.
(X*Y)*X = Y*X.
((Z*X)*Y)*X = Z*(Y*X).
(((Z*X)*Y)*X)*Y = (Z*X)*Y.
(Z*X = Z & Z*Y = Z) -> X*Y = Y*X.
c*a = a. a*c = c. c*b = b. b*c = c.
a*b = b.          % theta_b(a) = b
u = b*a.          % u = theta_a(b)
end_of_list.
formulas(goals).
u*b = b & a*u = b*u.     % theta_b(u) = b  and  theta_u(a) = theta_u(b)
end_of_list.
