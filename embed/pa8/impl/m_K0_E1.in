assign(max_seconds, 300). assign(max_megs, 2500).
set(prolog_style_variables).
op(400, infix, "*").
formulas(assumptions).
X*X = X.
(Y*X)*X = Y*X.
(X*Y)*X = Y*X.
((Z*X)*Y)*X = Z*(Y*X).
(((Z*X)*Y)*X)*Y = (Z*X)*Y.
(Z*X = Z & Z*Y = Z) -> X*Y = Y*X.
(C*A = A & A*C = C & C*B = B & B*C = C &
 Y*C = C*Y & B*Y = A*B & Z*B = B & A*Z = B*Z & Z*Y = B*A)
 -> (B*A = A & A*B = B).
kz*kb = kz & kb*ka = kz & kb*kd = kd & kc*kx = kz & kc*ka = ka & kc*kb = kb &
 ke*kx = ke & ke*kd = ke & kd*ka = ka.
kb*ka != ka.
end_of_list.
