assign(max_seconds, 120).
set(prolog_style_variables).
op(400, infix, "*").
formulas(assumptions).
X*X = X.
(Y*X)*X = Y*X.
(X*Y)*X = Y*X.
((Z*X)*Y)*X = Z*(Y*X).
(((Z*X)*Y)*X)*Y = (Z*X)*Y.
(Z*X = Z & Z*Y = Z) -> X*Y = Y*X.
(C*A = A & A*C = C & C*B = B & B*C = C &
 Y*A = A & B*Z = B & Y*C = C*Y & Y*Z = A*B & A*Z = B*A)
 -> (B*A = A & A*B = B).
kb*kd = kd & kc*ka = ka & kd*ka = ka & ku*kc = ku & ku*kd = ku & kc*kb = ku*ka.
end_of_list.
formulas(goals).
ku*ka = ka.
end_of_list.
