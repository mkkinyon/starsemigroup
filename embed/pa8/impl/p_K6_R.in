assign(max_seconds, 120).
set(prolog_style_variables).
op(400, infix, "*").
formulas(assumptions).
X*X = X.
(Y*X)*X = Y*X.
(X*Y)*X = Y*X.
((Z*X)*Y)*X = Z*(Y*X).
(((Z*X)*Y)*X)*Y = (Z*X)*Y.
(Z*X = Z & Z*Y = Z) -> X*Y = Y*X.
(C*A = A & A*C = C & C*B = B & B*C = C &
 Z*Y = A*Z & Z*C = A*Y & B*Z = A*B)
 -> (B*A = A & A*B = B).
kc*ka = ka & ka*kc = kc & kc*kb = kb & kb*kc = kc &
 kx*ka = ka*kx & kx*kc = kc*kx & kb*kx = kc*kx.
end_of_list.
formulas(goals).
kb*ka = ka & ka*kb = kb.
end_of_list.
