assign(max_seconds, 120).
set(prolog_style_variables).
op(400, infix, "*").
formulas(assumptions).
X*X = X.
(Y*X)*X = Y*X.
(X*Y)*X = Y*X.
((Z*X)*Y)*X = Z*(Y*X).
(((Z*X)*Y)*X)*Y = (Z*X)*Y.
(Z*X = Z & Z*Y = Z) -> X*Y = Y*X.
(C*A = A & A*C = C & C*B = B & B*C = C &
 X*C = C*X & X*Y = Y*X & Y*Z = Z*Y & Z*B = B*Z & A*X = C*X & A*Y = C*Y & A*Z = C*Z)
 -> (B*A = A & A*B = B).
kc*ka = ka & ka*kc = kc & kc*kb = kb & kb*kc = kc &
 kx*kc = kc*kx & ka*kx = kc*kx & ky*kb = kb*ky & kb*kx = ka*ky.
end_of_list.
formulas(goals).
kb*ka = ka & ka*kb = kb.
end_of_list.
