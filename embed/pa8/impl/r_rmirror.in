assign(max_seconds, 120).
set(prolog_style_variables).
op(400, infix, "*").
formulas(assumptions).
X*X = X.
(Y*X)*X = Y*X.
(X*Y)*X = Y*X.
((Z*X)*Y)*X = Z*(Y*X).
(((Z*X)*Y)*X)*Y = (Z*X)*Y.
(Z*X = Z & Z*Y = Z) -> X*Y = Y*X.
% (R)
(C*A = A & A*C = C & C*B = B & B*C = C & X*A = A*X & X*C = C*X & B*X = C*X) -> (B*A = A & A*B = B).
% hypotheses of the mirror (R)': x ~ b, x ~ c, th_x(a) = th_x(c)
c*a = a. a*c = c. c*b = b. b*c = c. p*b = b*p. p*c = c*p. a*p = c*p.
end_of_list.
formulas(goals).
b*a = a & a*b = b.
end_of_list.
