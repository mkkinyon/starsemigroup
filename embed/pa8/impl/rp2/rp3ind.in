set(prolog_style_variables). assign(max_seconds, 36000). assign(max_megs, 3000). op(400, infix, "*").
formulas(assumptions).
X*X = X.
(Y*X)*X = Y*X.
(X*Y)*X = Y*X.
((Z*X)*Y)*X = Z*(Y*X).
(((Z*X)*Y)*X)*Y = (Z*X)*Y.
(Z*X = Z & Z*Y = Z) -> X*Y = Y*X.
% (S), (R), (R'), (V), (R''), (W2), (W3)
(C*A = A & A*C = C & C*B = B & B*C = C & D*B = B & B*D = D & C*D = D*C & (C*D)*A = (C*D)*B) -> (D*A = A & A*D = D).
(C*A = A & A*C = C & C*B = B & B*C = C & X*A = A*X & X*C = C*X & B*X = C*X) -> (B*A = A & A*B = B).
(C*A = A & A*C = C & C*B = B & B*C = C & X*C = C*X & A*X = C*X & Y*A = A*Y & B*X = B*Y) -> (B*A = A & A*B = B).
(C*B = B & (T*A)*B = T*A & (T*C)*A = T*C) -> (T*A)*(T*B) = T*A.
(C*A = A & A*C = C & C*B = B & B*C = C & X*C = C*X & A*X = C*X & Y*B = B*Y & B*X = A*Y) -> (B*A = A & A*B = B).
(C*A = A & A*C = C & C*B = B & B*C = C & X*C = C*X & Y*B = B*Y & X*Y = Y*X & A*X = C*X & A*Y = C*Y) -> (B*A = A & A*B = B).
(C*A = A & A*C = C & C*B = B & B*C = C & X*C = C*X & X*Y = Y*X & Y*Z = Z*Y & Z*B = B*Z & A*X = C*X & A*Y = C*Y & A*Z = C*Z) -> (B*A = A & A*B = B).
% (R'2)
(C*A = A & A*C = C & C*B = B & B*C = C & X*C = C*X & X*Y = Y*X & A*X = C*X & A*Y = C*Y & Z*A = A*Z & B*Y = B*Z) -> (B*A = A & A*B = B).
% negated (R'3): c ~ p ~ q ~ r all identifying a with c, k ~ a, th_r(b) = th_k(b), not a |><| b.  Expected smallest model: P^{R'}_3, order 12.
c*a = a. a*c = c. c*b = b. b*c = c. p*c = c*p. p*q = q*p. q*r = r*q. a*p = c*p. a*q = c*q. a*r = c*r. k*a = a*k. b*r = b*k.
b*a != a | a*b != b.
end_of_list.
