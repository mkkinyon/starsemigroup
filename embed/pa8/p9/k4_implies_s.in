set(prolog_style_variables).
assign(max_seconds, 36000). assign(max_megs, 3000). op(400, infix, "*").
formulas(assumptions).
X*X = X.
(Y*X)*X = Y*X.
(X*Y)*X = Y*X.
((Z*X)*Y)*X = Z*(Y*X).
(((Z*X)*Y)*X)*Y = (Z*X)*Y.
(Z*X = Z & Z*Y = Z) -> X*Y = Y*X.
% K4 as hypothesis
(C*A = A & A*C = C & C*B = B & B*C = C & Y*A = A & B*Z = B & Y*C = C*Y & Y*Z = A*B & A*Z = B*A) -> (B*A = A & A*B = B).
% negated (S) [picture only, (S) is proved]: a|><|c|><|b|><|d, c ~ d, theta_{cd}(a) = theta_{cd}(b), not a|><|d.
c*a = a. a*c = c. c*b = b. b*c = c. d*b = b. b*d = d. c*d = d*c. (c*d)*a = (c*d)*b.
d*a != a | a*d != d.
end_of_list.
