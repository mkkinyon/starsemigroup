op(400, infix_left, "*").
assign(max_seconds, 1800).
formulas(assumptions).
(x*y)*z = x*(y*z).
(x*y)' = y'*x'.
x'' = x.
x*x'*x = x.
a*a = a. a' = a. b*b = b. b' = b. c*c = c. c' = c. d*d = d. d' = d. g*g = g. g' = g. k*k = k. k' = k.
a*c*a = a. c*a*c = c. c*b*c = c. b*c*b = b. b*d*b = b. d*b*d = d.
g*a = a*g. g*b = b*g. g*c*g = g*b*g.
a*k*a = k. c*k*c = d*k*d. c*d = d*c.
g*c = g*b*c. g*c*b = g*b. k*d = k*c*b*d. k*d = k*c*d. c*g = c*b*g. b*c*g = b*g.
(p*p = p & p' = p & q*q = q & q' = q & r*r = r & r' = r & p*q*p = q & p*r*p = r) -> q*r = r*q.
end_of_list.
formulas(goals).
g*d*g = g*b*g.
end_of_list.
