op(400, infix_left, "*").
assign(max_seconds, 240).
formulas(assumptions).
(x*y)*z = x*(y*z).
(x*y)' = y'*x'.
x'' = x.
x*x'*x = x.
% projections a,b,c,e (= x1), g (= x2), f (= y)
a*a = a. a' = a. b*b = b. b' = b. c*c = c. c' = c. e*e = e. e' = e. g*g = g. g' = g. f*f = f. f' = f.
% hypotheses of (R'_2)
a*c*a = a. c*a*c = c. b*c*b = b. c*b*c = c. e*c = c*e. e*g = g*e. e*a*e = e*c*e. g*a*g = g*c*g. f*a = a*f. g*b*g = f*b*f.
% consequences of (Q1): x2 y = y x2 (common lower bound r), c y = y c (verified on instances)
g*f = f*g.
end_of_list.
formulas(goals).
b*g = b*f.
end_of_list.
