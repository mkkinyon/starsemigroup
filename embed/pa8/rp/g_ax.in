assign(max_seconds, 600).
op(400, infix_left, "*").
formulas(assumptions).
(x*y)*z = x*(y*z).
(x*y)' = y'*x'.
x'' = x.
x*x'*x = x.
% projections a,b,c,e,f  (e = x, f = y)
a*a = a. a' = a. b*b = b. b' = b. c*c = c. c' = c. e*e = e. e' = e. f*f = f. f' = f.
c*b*c = c. b*c*b = b. e*c = c*e. e*a*e = e*c*e. f*a = a*f. e*b*e = f*b*f.
end_of_list.
formulas(goals).
a*e = f*a*c.
end_of_list.
