assign(max_seconds, 600). assign(max_megs, 3000).
set(prolog_style_variables).
op(400, infix, "*").
formulas(assumptions).
X*X = X.
(Y*X)*X = Y*X.
(X*Y)*X = Y*X.
((Z*X)*Y)*X = Z*(Y*X).
(((Z*X)*Y)*X)*Y = (Z*X)*Y.
(Z*X = Z & Z*Y = Z) -> X*Y = Y*X.
% hypotheses of (R'): a|><|c, b|><|c, xc = cx, theta_x(a) = theta_x(c), ya = ay, theta_x(b) = theta_y(b)
c*a = a. a*c = c. c*b = b. b*c = c. x*c = c*x. a*x = c*x. y*a = a*y. b*x = b*y.
c*y != c*x.
end_of_list.
