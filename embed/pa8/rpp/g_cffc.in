op(400, infix_left, "*").
set(prolog_style_variables).
assign(max_seconds, 300).
formulas(assumptions).
(X*Y)*Z = X*(Y*Z).
(X*Y)' = Y'*X'.
X'' = X.
X*X'*X = X.
% (Q1) for projections: common lower bound => commute
(P*P = P & P' = P & Q*Q = Q & Q' = Q & R*R = R & R' = R & R*P = R & R*Q = R) -> P*Q = Q*P.
% projections a,b,c,e (= x), f (= y)
a*a = a. a' = a. b*b = b. b' = b. c*c = c. c' = c. e*e = e. e' = e. f*f = f. f' = f.
% hypotheses of (R''): a~c, b~c, xc = cx, theta_x(a) = theta_x(c), yb = by, theta_x(b) = theta_y(a)
a*c*a = a. c*a*c = c. b*c*b = b. c*b*c = c. e*c = c*e. e*a*e = e*c*e. f*b = b*f. e*b*e = f*a*f.
end_of_list.
formulas(goals).
c*f = f*c.
end_of_list.
