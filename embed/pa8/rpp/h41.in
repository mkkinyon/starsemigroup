set(prolog_style_variables).
assign(max_seconds, 280).
op(400, infix, "*").
formulas(assumptions).
X*X = X.
(Y*X)*X = Y*X.
(X*Y)*X = Y*X.
((Z*X)*Y)*X = Z*(Y*X).
(((Z*X)*Y)*X)*Y = (Z*X)*Y.
(Z*X = Z & Z*Y = Z) -> X*Y = Y*X.
% (R'') hypotheses, binary notation p*q = theta_q(p): a~c, b~c, xc=cx, th_x(a)=th_x(c), yb=by, th_x(b)=th_y(a)
c*a = a. a*c = c. c*b = b. b*c = c. x*c = c*x. a*x = c*x. y*b = b*y. b*x = a*y.
% derived: th_a(y)=th_a(x), xy=yx, th_y(v)=r, th_x(w)=r
y*a = x*a. x*y = y*x. (x*c)*y = b*x. (y*b)*x = b*x.
end_of_list.
formulas(goals).
y*c = x*c.
end_of_list.
