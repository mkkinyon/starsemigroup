set(prolog_style_variables). assign(max_seconds, 3600). assign(max_megs, 3000). op(400, infix, "*").
formulas(assumptions).
X*X = X.
(Y*X)*X = Y*X.
(X*Y)*X = Y*X.
((Z*X)*Y)*X = Z*(Y*X).
(((Z*X)*Y)*X)*Y = (Z*X)*Y.
(Z*X = Z & Z*Y = Z) -> X*Y = Y*X.
% (W_1)
(C*A = A & A*C = C & C*B = B & B*C = C & V1*C = C*V1 & V1*B = B*V1 & A*V1 = C*V1) -> (B*A = A & A*B = B).
(C*A = A & A*C = C & C*B = B & B*C = C & D*B = B & B*D = D & C*D = D*C & (C*D)*A = (C*D)*B) -> (D*A = A & A*D = D).
(C*B = B & (T*A)*B = T*A & (T*C)*A = T*C) -> (T*A)*(T*B) = T*A.
% fixed part of the table (X*Y = theta_Y(X))
