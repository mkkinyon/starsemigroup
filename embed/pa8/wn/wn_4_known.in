set(prolog_style_variables). assign(max_seconds, 3600). assign(max_megs, 3000). op(400, infix, "*").
formulas(assumptions).
X*X = X.
(Y*X)*X = Y*X.
(X*Y)*X = Y*X.
((Z*X)*Y)*X = Z*(Y*X).
(((Z*X)*Y)*X)*Y = (Z*X)*Y.
(Z*X = Z & Z*Y = Z) -> X*Y = Y*X.
% (W_3)
(C*A = A & A*C = C & C*B = B & B*C = C & V1*C = C*V1 & V3*B = B*V3 & V1*V2 = V2*V1 & V2*V3 = V3*V2 & A*V1 = C*V1 & A*V2 = C*V2 & A*V3 = C*V3) -> (B*A = A & A*B = B).
% (Tri)
(B1*B2 = Z & B2*B1 = Z & B2*B3 = Z & B3*B2 = Z & B3*B1 = Z & B1*B3 = Z & A1*B1 = B1*A1 & A2*B2 = B2*A2 & A3*B3 = B3*A3 & B2*A1 = A1 & A1*B2 = B2 & B3*A2 = A2 & A2*B3 = B3 & B1*A3 = A3 & A3*B1 = B1 & A1*A2 = W & A2*A1 = W & A2*A3 = W & A3*A2 = W & A3*A1 = W & A1*A3 = W) -> W = Z.
(C*A = A & A*C = C & C*B = B & B*C = C & D*B = B & B*D = D & C*D = D*C & (C*D)*A = (C*D)*B) -> (D*A = A & A*D = D).
(C*B = B & (T*A)*B = T*A & (T*C)*A = T*C) -> (T*A)*(T*B) = T*A.
