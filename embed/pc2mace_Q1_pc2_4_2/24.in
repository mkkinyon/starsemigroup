op(400, infix, "*").
formulas(assumptions).
x * x = x.
(y * x) * x = y * x.
(x * y) * x = y * x.
((z * x) * y) * x = z * (y * x).
(((z * x) * y) * x) * y = (z * x) * y.
z * x != z | z * y != z | x * y = y * x.
a1 * a0 = a0. a0 * a1 = a1.
a2 * a1 = a1. a1 * a2 = a2.
c * a1 = c.
a0 * d = d * a0.
a2 * d = c.
a2 * a0 != a0 | a0 * a2 != a2.
end_of_list.
