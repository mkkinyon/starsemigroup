% (P) Periodic points of the walk close up after one full turn.
% A closed 12-cycle e0 -> e1 -> ... -> e11 -> e0 of the walk (e0 under b3), half-matched
% at every step, with the lower bounds, satisfies e6 = e0.
% (In all six Mace4 models the full-turn operator has only fixed points as periodic points.)
% For Mace4: replace the goal by the assumption  e6 != e0.
op(400, infix, "*").

formulas(assumptions).
x * x = x.
(y * x) * x = y * x.
(x * y) * x = y * x.
((z * x) * y) * x = z * (y * x).
(((z * x) * y) * x) * y = (z * x) * y.
a1 * a2 = cw.   a2 * a3 = cw.   a3 * a1 = cw.
b1 * b2 = cz.   b2 * b3 = cz.   b3 * b1 = cz.
a1 * b1 = b1 * a1.   a2 * b2 = b2 * a2.   a3 * b3 = b3 * a3.
b2 * a1 = a1.   a1 * b2 = b2.
b3 * a2 = a2.   a2 * b3 = b3.
b1 * a3 = a3.   a3 * b1 = b1.
% meets m_i = a_i b_i as constants
a1 * b1 = m1.   a2 * b2 = m2.   a3 * b3 = m3.
e0 * a2 = e1.
e1 * b1 = e2.
e2 * a3 = e3.
e3 * b2 = e4.
e4 * a1 = e5.
e5 * b3 = e6.
e6 * a2 = e7.
e7 * b1 = e8.
e8 * a3 = e9.
e9 * b2 = e10.
e10 * a1 = e11.
e11 * b3 = e0.
a2 * e0 = e0.
b1 * e1 = e1.
a3 * e2 = e2.
b2 * e3 = e3.
a1 * e4 = e4.
b3 * e5 = e5.
a2 * e6 = e6.
b1 * e7 = e7.
a3 * e8 = e8.
b2 * e9 = e9.
a1 * e10 = e10.
b3 * e11 = e11.
cz * e0 = cz.   m3 * e0 = m3.
cw * e1 = cw.   m2 * e1 = m2.
cz * e2 = cz.   m1 * e2 = m1.
cw * e3 = cw.   m3 * e3 = m3.
cz * e4 = cz.   m2 * e4 = m2.
cw * e5 = cw.   m1 * e5 = m1.
cz * e6 = cz.   m3 * e6 = m3.
cw * e7 = cw.   m2 * e7 = m2.
cz * e8 = cz.   m1 * e8 = m1.
cw * e9 = cw.   m3 * e9 = m3.
cz * e10 = cz.   m2 * e10 = m2.
cw * e11 = cw.   m1 * e11 = m1.
end_of_list.

formulas(goals).
e6 = e0.
end_of_list.
