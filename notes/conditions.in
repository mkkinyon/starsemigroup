% ---------------------------------------------------------------------------
% Projection algebras and the obstruction conditions for embeddability in P_X.
%
% Binary notation:  X*Y = theta_Y(X) = Y X Y   (the value of the operation is
% below its second argument).  Consequently
%   Q <= P            is  Q*P = Q
%   P and Q commute   is  P*Q = Q*P
%   P |><| Q (matched) is  Q*P = P  &  P*Q = Q
%
% Variables are Prolog style (capitalised); every lowercase symbol is a
% constant, so goals may use any lowercase names (a, b, c, p0, ... ).
% Each formula carries a label; delete or comment out the ones not wanted.
% The formulas in this list hold in the projection algebra of every partition
% monoid, except that K5 is only verified for P_m, m <= 6 (K6 is proved via (W2);
% K4 is proved in every P_X, Thm 5.49 of 16 Oct, hence (E6) is proved via k4_implies_e6.pf;
% K0 is proved in every P_X, Thm 5.50 of 16 Oct, hence (E1) is proved via k0_implies_e1.pf)
% (see notes-embedding, Prop. 5.19 and Section 5.9); (Q), and hence (P2)
% and (S), are proved in Section 5.11 (Theorem thm:Q).
% Known implications: (Q) -> (P2) -> (S);  (R') -> (R)  [from the axioms alone: instantiate
% (R') at X := x*c, Y := x; Prover9 closes the instance in seconds].
% ---------------------------------------------------------------------------

set(prolog_style_variables).
op(400, infix, "*").

formulas(assumptions).

% --- projection algebra axioms -------------------------------------------
X*X = X                                        # label("PA1").
(Y*X)*X = Y*X                                  # label("PA2").
(X*Y)*X = Y*X                                  # label("PA3").
((Z*X)*Y)*X = Z*(Y*X)                          # label("PA4").
(((Z*X)*Y)*X)*Y = (Z*X)*Y                      # label("PA5").

% --- (Q1): a common lower bound forces commutation --------------------------
(Z*X = Z & Z*Y = Z) -> X*Y = Y*X                # label("(Q1)").

% --- triangle condition (matching pattern E = {(1,2),(2,3),(3,1)}) -----------
% A1,A2,A3 pairwise commuting with common meet W; B1,B2,B3 likewise with meet Z;
% Ai commutes with Bi; A1|><|B2, A2|><|B3, A3|><|B1.  Conclusion W = Z.
(A1*A2 = W & A2*A1 = W & A2*A3 = W & A3*A2 = W & A3*A1 = W & A1*A3 = W &
 B1*B2 = Z & B2*B1 = Z & B2*B3 = Z & B3*B2 = Z & B3*B1 = Z & B1*B3 = Z &
 A1*B1 = B1*A1 & A2*B2 = B2*A2 & A3*B3 = B3*A3 &
 B2*A1 = A1 & A1*B2 = B2 & B3*A2 = A2 & A2*B3 = B3 & B1*A3 = A3 & A3*B1 = B1)
 -> W = Z                                       # label("(Tri)").

% --- (S): full wiring condition (Theorem thm:S) ------------------------------
% A|><|C, B|><|C, B|><|D, CD = DC, theta_A(CD) = theta_B(CD)  =>  A|><|D.
(C*A = A & A*C = C & C*B = B & B*C = C & D*B = B & B*D = D &
 C*D = D*C & (C*D)*A = (C*D)*B)
 -> (D*A = A & A*D = D)                         # label("(S)").

% --- (R): Theorem thm:R ------------------------------------------------------
% A|><|C, B|><|C, XA = AX, XC = CX, theta_X(B) = theta_X(C)  =>  A|><|B.
(C*A = A & A*C = C & C*B = B & B*C = C &
 X*A = A*X & X*C = C*X & B*X = C*X)
 -> (B*A = A & A*B = B)                         # label("(R)").

% --- (R'): Theorem thm:Rp; implies (R) -----------------------------------------
% A|><|C, B|><|C, XC = CX, theta_X(A) = theta_X(C), YA = AY, theta_X(B) = theta_Y(B)
%   =>  A|><|B.
(C*A = A & A*C = C & C*B = B & B*C = C &
 X*C = C*X & A*X = C*X & Y*A = A*Y & B*X = B*Y)
 -> (B*A = A & A*B = B)                         # label("(R')").

% --- (V): Theorem thm:V ------------------------------------------------------
% BCB = B, ATA <= B, CTC <= A  =>  ATA <= BTB   (in fact ATA = BTB in P_X).
(C*B = B & (T*A)*B = T*A & (T*C)*A = T*C)
 -> (T*A)*(T*B) = T*A                           # label("(V)").
% equality form, valid in every P_X:
% (C*B = B & (T*A)*B = T*A & (T*C)*A = T*C) -> T*A = T*B   # label("(V=)").

% --- path-closing conditions on a path P0|><|P1|><|P2|><|P3 -------------------
% (P1) [Theorem thm:P1]: X commutes with P0,P1; theta_P0(X) = theta_P2(X); theta_X(P1) = theta_X(P3).
(P1*P0 = P0 & P0*P1 = P1 & P2*P1 = P1 & P1*P2 = P2 & P3*P2 = P2 & P2*P3 = P3 &
 P0*X = X*P0 & P1*X = X*P1 & X*P0 = X*P2 & P1*X = P3*X)
 -> (P3*P0 = P0 & P0*P3 = P3)                   # label("(P1)").

% (P2): X commutes with P0,P2; theta_X(P1) = theta_X(P2); theta_P1(X) = theta_P3(X).
% Follows from (Q) with Y = X; implies (S).
(P1*P0 = P0 & P0*P1 = P1 & P2*P1 = P1 & P1*P2 = P2 & P3*P2 = P2 & P2*P3 = P3 &
 P0*X = X*P0 & P2*X = X*P2 & P1*X = P2*X & X*P1 = X*P3)
 -> (P3*P0 = P0 & P0*P3 = P3)                   # label("(P2)").

% (Q): X commutes with P0, theta_P1(X) = theta_P3(X);
%      Y commutes with P0,P2, theta_Y(P1) = theta_Y(P2).
(P1*P0 = P0 & P0*P1 = P1 & P2*P1 = P1 & P1*P2 = P2 & P3*P2 = P2 & P2*P3 = P3 &
 P0*X = X*P0 & X*P1 = X*P3 & P0*Y = Y*P0 & P2*Y = Y*P2 & P1*Y = P2*Y)
 -> (P3*P0 = P0 & P0*P3 = P3)                   # label("(Q)").

% --- (E6): the condition violated by P_8^6; PROVED (consequence of (Q1)+K4, and K4 is proved, Thm 5.49) ---
% DBD = D, ACA = A, ADA = A, U <= C, U <= D, BCB = AUA  =>  AUA = A.
(B*D = D & C*A = A & D*A = A & U*C = U & U*D = U & C*B = U*A)
 -> U*A = A                                     # label("(E6)").

% --- (E1): the condition violated by P_8^1; PROVED (consequence of (Q1)+(W2)+K0, Prover9, M.K., 13 Oct 2026, p9/k0_implies_e1.pf; and K0 is proved, Thm 5.50) ---
% Z <= B, ABA = Z, DBD = D, XCX = Z, ACA = A, BCB = B, E <= X, E <= D, ADA = A
%   =>  ABA = A.
(Z*B = Z & B*A = Z & B*D = D & C*X = Z & C*A = A & C*B = B &
 E*X = E & E*D = E & D*A = A)
 -> B*A = A                                     # label("(E1)").


% --- (R''): Section 5.13; PROVED: a consequence of (Q1) and (W2) in every projection algebra (Prover9, M.K., 11 Oct 2026; p9/rpp_vs_chain.pf)
% A|><|C, B|><|C, XC = CX, theta_X(A) = theta_X(C), YB = BY, theta_X(B) = theta_Y(A)  =>  A|><|B.
(C*A = A & A*C = C & C*B = B & B*C = C &
 X*C = C*X & A*X = C*X & Y*B = B*Y & B*X = A*Y)
 -> (B*A = A & A*B = B)                         # label("(R'')").

% --- (W2), (W3): Section 5.14; PROVED for all n (11 Oct 2026, Section 5.20: counting invariant) -------
% A|><|C, B|><|C, XC = CX, YB = BY, XY = YX, theta_X(A) = theta_X(C), theta_Y(A) = theta_Y(C)  =>  A|><|B.
(C*A = A & A*C = C & C*B = B & B*C = C &
 X*C = C*X & Y*B = B*Y & X*Y = Y*X & A*X = C*X & A*Y = C*Y)
 -> (B*A = A & A*B = B)                         # label("(W2)").
% chain C ~ X ~ Y ~ Z ~ B, each identifying A with C.
(C*A = A & A*C = C & C*B = B & B*C = C &
 X*C = C*X & X*Y = Y*X & Y*Z = Z*Y & Z*B = B*Z & A*X = C*X & A*Y = C*Y & A*Z = C*Z)
 -> (B*A = A & A*B = B)                         # label("(W3)").

% --- (R'2), (R'3): the hybrid chain family of Section 5.16(c)/5.17; verified in P(P_m) for m <= 5 only.
% (R'_n): A|><|C, B|><|C, chain C ~ X1 ~ ... ~ Xn each identifying A with C, YA = AY, theta_{Xn}(B) = theta_Y(B)  =>  A|><|B;  (R'1) = (R').
(C*A = A & A*C = C & C*B = B & B*C = C &
 X*C = C*X & X*Y = Y*X & A*X = C*X & A*Y = C*Y & Z*A = A*Z & B*Y = B*Z)
 -> (B*A = A & A*B = B)                         # label("(R'2)").
(C*A = A & A*C = C & C*B = B & B*C = C &
 X*C = C*X & X*Y = Y*X & Y*Z = Z*Y & A*X = C*X & A*Y = C*Y & A*Z = C*Z & T*A = A*T & B*Z = B*T)
 -> (B*A = A & A*B = B)                         # label("(R'3)").

% --- K0, K4, K5, K6 (Section 5.13; K5 verified m <= 6 only; K0 and its variant K0'' PROVED in every P_X (Thm 5.50), K4 PROVED in every P_X (Thm 5.49), K6 proved via (W2)). Path A|><|C|><|B; U = theta_A(B) = B*A, V = theta_B(A) = A*B.
% K0: YC = CY, theta_Y(B) = V, BZB = B, theta_Z(A) = theta_Z(B), theta_Y(Z) = U  =>  A|><|B.   PROVED in every P_X (Thm 5.50, 16 Oct 2026).
(C*A = A & A*C = C & C*B = B & B*C = C &
 Y*C = C*Y & B*Y = A*B & Z*B = B & A*Z = B*Z & Z*Y = B*A)
 -> (B*A = A & A*B = B)                         # label("(K0)").
% K0'': the variant proved by the same argument (Thm 5.50 and the paragraph after it): theta_Z(A) = theta_Z(B) replaced by
% theta_A(Z) = A, i.e. Z is a common matched partner of A and B.  PROVED in every P_X (16 Oct 2026). In P(P_4) its instance
% set coincides with that of K0. NOT a consequence of K0 or of any other condition in this file: M.K.'s Mace4 model of order 9
% (16 Oct; (Q1)+K0, not K0'') is candidate 5 of the order-9 census, which violates exactly K0'' and K5 (pa8/k0pp/evalcond.log).
% So candidate 5 is proved non-embeddable without a proof of K5. Whether K0'' implies K0 (with (Q1)) is OPEN: every known
% violator of K0 (P_8^1, candidate 0) violates K0'' too; in P_X the K0 hypotheses give theta_A(Z) = A by a rank count.
(C*A = A & A*C = C & C*B = B & B*C = C &
 Y*C = C*Y & B*Y = A*B & Z*A = A & Z*B = B & Z*Y = B*A)
 -> (B*A = A & A*B = B)                         # label("(K0'')").
% K4a: AYA = A, B <= Z, YC = CY, theta_Z(Y) = V, theta_Z(A) = U  =>  A|><|B.   PROVED in every P_X (Thm 5.49, 16 Oct 2026).
(C*A = A & A*C = C & C*B = B & B*C = C &
 Y*A = A & B*Z = B & Y*C = C*Y & Y*Z = A*B & A*Z = B*A)
 -> (B*A = A & A*B = B)                         # label("(K4)").
% K5: theta_X(C) = A, BXB = B, ZC = CZ, theta_Z(X) = U, theta_Z(B) = V  =>  A|><|B.
(C*A = A & A*C = C & C*B = B & B*C = C &
 C*X = A & X*B = B & Z*C = C*Z & X*Z = B*A & B*Z = A*B)
 -> (B*A = A & A*B = B)                         # label("(K5)").
% K6: theta_Y(Z) = theta_Z(A), theta_C(Z) = theta_Y(A), theta_Z(B) = V  =>  A|><|B.   PROVED: consequence of (Q1)+(W2) (Prover9, M.K., 11 Oct; p9/k6_vs_chain.pf)
(C*A = A & A*C = C & C*B = B & B*C = C &
 Z*Y = A*Z & Z*C = A*Y & B*Z = A*B)
 -> (B*A = A & A*B = B)                         # label("(K6)").

end_of_list.

% formulas(goals).
% end_of_list.
